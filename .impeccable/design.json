  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Acción principal, una por vista.",
      "html": "<button class=\"ds-btn-primary\">Registrar apuesta</button>",
      "css": ".ds-btn-primary{height:36px;padding:0 10px;border-radius:var(--radius);font:500 14px var(--font-sans);cursor:pointer;transition:background .15s,transform .15s;border:1px solid transparent;background:var(--primary);color:var(--primary-foreground)}.ds-btn-primary:hover{background:color-mix(in srgb,var(--primary) 80%,transparent)}.ds-btn-primary:active{transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Acción alternativa en verde cancha.",
      "html": "<button class=\"ds-btn-secondary\">Ver historial</button>",
      "css": ".ds-btn-secondary{height:36px;padding:0 10px;border-radius:var(--radius);font:500 14px var(--font-sans);cursor:pointer;transition:background .15s,transform .15s;border:1px solid transparent;background:var(--secondary);color:var(--secondary-foreground)}.ds-btn-secondary:hover{background:color-mix(in oklch,var(--secondary),var(--foreground) 5%)}.ds-btn-secondary:active{transform:translateY(1px)}.ds-btn-secondary:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Outline Button",
      "kind": "button",
      "refersTo": "button-outline",
      "description": "Filtros y acciones de simulación.",
      "html": "<button class=\"ds-btn-outline\">Filtrar ligas</button>",
      "css": ".ds-btn-outline{height:36px;padding:0 10px;border-radius:var(--radius);font:500 14px var(--font-sans);cursor:pointer;transition:background .15s,transform .15s;border:1px solid var(--input);background:color-mix(in srgb,var(--input) 30%,transparent);color:var(--foreground)}.ds-btn-outline:hover{background:color-mix(in srgb,var(--input) 50%,transparent)}.ds-btn-outline:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Cancelar y controles discretos.",
      "html": "<button class=\"ds-btn-ghost\">Cancelar</button>",
      "css": ".ds-btn-ghost{height:36px;padding:0 10px;border-radius:var(--radius);font:500 14px var(--font-sans);cursor:pointer;transition:background .15s,transform .15s;border:0;background:transparent;color:var(--foreground)}.ds-btn-ghost:hover{background:color-mix(in srgb,var(--muted) 50%,transparent)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ring);outline-offset:2px}"
    },
    {
      "name": "Status Badge",
      "kind": "chip",
      "refersTo": "status-badge",
      "description": "Estado o señal: ícono + palabra + tinte al 14 %.",
      "html": "<span class=\"ds-badge ds-badge-value\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M16 7h6v6\"/><path d=\"m22 7-8.5 8.5-5-5L2 17\"/></svg>Value +6,2 %</span> <span class=\"ds-badge ds-badge-lost\"><svg viewBox=\"0 0 24 24\" width=\"12\" height=\"12\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"m15 9-6 6M9 9l6 6\"/></svg>Perdida</span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;height:24px;padding:0 10px;border-radius:2rem;font:500 13px var(--font-sans)}.ds-badge-value{background:color-mix(in srgb,var(--value) 14%,transparent);color:var(--value)}.ds-badge-lost{background:color-mix(in srgb,var(--lost) 14%,transparent);color:var(--lost)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Contenedor tonal, sin sombra en reposo.",
      "html": "<div class=\"ds-card\"><p class=\"ds-card-meta\">Primera División · Hoy 20:30</p><p class=\"ds-card-title\">Colo-Colo</p><p class=\"ds-card-fig\">1,85</p></div>",
      "css": ".ds-card{background:var(--card);color:var(--card-foreground);border:1px solid var(--border);border-radius:calc(var(--radius)*1.8);padding:20px}.ds-card-meta{margin:0;font:400 14px var(--font-sans);color:var(--muted-foreground)}.ds-card-title{margin:16px 0 0;font:400 56px/0.92 var(--font-display);text-transform:uppercase}.ds-card-fig{margin:8px 0 0;font:400 18px var(--font-mono);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Probability Bar",
      "kind": "custom",
      "refersTo": "probability-bar",
      "description": "Modelo vs probabilidad implícita; el tramo entre ambos es el value.",
      "html": "<div class=\"ds-pb\" role=\"meter\" aria-label=\"Probabilidad del modelo frente a la cuota\" aria-valuenow=\"57.4\" aria-valuemin=\"0\" aria-valuemax=\"100\" aria-valuetext=\"Modelo 57,4 %, la cuota implica 54,1 %, value +6,2 %\"><div class=\"ds-pb-track\"><span class=\"ds-pb-fill\" style=\"width:57.4%\"></span><span class=\"ds-pb-gap\" style=\"left:54.1%;width:3.3%\"></span><span class=\"ds-pb-tick\" style=\"left:54.1%\"></span></div><p class=\"ds-pb-ev\">Value +6,2 %</p></div>",
      "css": ".ds-pb{background:var(--card);border:1px solid var(--border);border-radius:calc(var(--radius)*1.8);padding:20px}.ds-pb-track{position:relative;height:12px;border-radius:9999px;background:var(--muted)}.ds-pb-fill{position:absolute;inset:0 auto 0 0;border-radius:9999px;background:color-mix(in srgb,var(--foreground) 25%,transparent)}.ds-pb-gap{position:absolute;top:0;bottom:0;border-radius:9999px;background:var(--value)}.ds-pb-tick{position:absolute;top:-6px;bottom:-6px;width:2px;transform:translateX(-50%);border-radius:9999px;background:var(--foreground)}.ds-pb-ev{margin:16px 0 0;font:400 14px var(--font-mono);font-variant-numeric:tabular-nums;color:var(--value)}"
    },
    {
      "name": "Dock",
      "kind": "nav",
      "refersTo": "dock",
      "description": "Navegación flotante de escritorio.",
